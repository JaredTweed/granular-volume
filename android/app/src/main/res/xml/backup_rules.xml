<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (fullBackupContent).

  Exactly one file is backed up: gv_entitlement.xml, which holds the trial start date,
  the clock high-water mark and the grandfather verdict. Everything else the app stores,
  the dial position, overlay coordinates, tile and tooltip state, is deliberately left
  out, so the backup carries entitlement and nothing about how the person uses the app.
-->
<full-backup-content>
    <include domain="sharedpref" path="gv_entitlement.xml" />
    <exclude domain="sharedpref" path="gv_prefs.xml" />
</full-backup-content>
