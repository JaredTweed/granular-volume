<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above.

  cloud-backup covers Google's own backup; device-transfer covers a direct phone to phone move.
  Both are limited to gv_entitlement.xml for the same reason: the trial has to survive a reinstall
  or a new phone, while the person's settings and usage stay on the device they were made on.
  Naming an include is what excludes everything else; see backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="gv_entitlement.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="gv_entitlement.xml" />
    </device-transfer>
</data-extraction-rules>
